# ==============================================================================
# IoT Anomaly Detection - Environment Configuration Template
# Copy this file to .env and adjust values if needed.
# ==============================================================================

# Mosquitto MQTT Broker
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=factory

# InfluxDB 2.x Settings
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=iot-anomaly-secret-auth-token-987654321
INFLUXDB_ORG=iot_org
INFLUXDB_BUCKET=sensor_telemetry
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=adminpassword123
DOCKER_INFLUXDB_INIT_RETENTION=7d

# Grafana Settings
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Simulator Settings
SIMULATOR_PUBLISH_INTERVAL_SEC=1.0
SIMULATOR_ANOMALY_RATE=0.05
SIMULATOR_MACHINES=machine_1,machine_2

# Ingestor & Detector Settings
INGESTOR_DETECTOR_TYPE=zscore
ZSCORE_THRESHOLD=3.0
ZSCORE_WINDOW_SIZE=30
IFOREST_WARMUP_SAMPLES=40
IFOREST_CONTAMINATION=0.05
